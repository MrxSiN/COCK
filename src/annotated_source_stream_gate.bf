
# MODULE annotated source streaming lexical and bracket gate

# PURPOSE validate strict original source line syntax and balanced loops

# INPUT consecutive byte count records terminated by a zero count record

# INPUT every record ends with mandatory A5 guard byte

# OUTPUT one byte value one for valid or zero for rejected

# TAPE cell zero holds current record byte count

# TAPE cell one holds current annotated source byte

# TAPE cells two and three comparator scratch

# TAPE cell four code line mode and five comment line mode

# TAPE cell six pending carriage return and seven sticky rejection

# TAPE cells eight through fifteen character classifier flags

# TAPE cell seventeen is nesting depth and eighteen printable candidate

# TAPE cell nineteen printable comparison budget

# TAPE cell twenty is the active record loop flag

# TAPE cells twenty one through twenty six are scratch and classifier flags

# CONTRACT original eight commands in code lines only

# CONTRACT hash comments require first nonblank glyph of a line

# CONTRACT comment text printable ASCII without commands

# CONTRACT line endings LF or CRLF only

# BUDGET per record at most 255 bytes and nesting at most 255

# LIMITATION depth overflow rejects until a larger representation exists

# LIMITATION guard does not independently prove host closure

# LIMITATION Boolean result omits original source error offsets

# LIMITATION output does not include normalized program bytes

# Start one or more guarded input records
>>>>>>>>>>>>>>>>>>>>[-]+[[-]<<<<<<<<<<<<<<<<<<<<,>>>>>>>>>>>>>>>>>>>>>>>>[-]>[-]<<<<<<<<<<<<<<<<<<<<<<<<<[->>>>>>>>>>>>>>>>>>>>>>>>+>+<<<<<<<<<<<<<<<<<<<<<<<<<]>>>>>>>>>>>>>>>>>>>>>>>>>[-<<<<<<<<<<<<<<<<<<<<<<<<<+>>>>>>>>>>>>>>>>>>>>>>>>>]<[[-]<<<<[-]+>>>>]
# Consume every declared source byte in current record
<<<<<<<<<<<<<<<<<<<<<<<<[->,>>>>>>>[-]>[-]>[-]>[-]>[-]>[-]>[-]>[-]>[-]>>>>>>[-]>[-]
# Recognize original line whitespace and structural bytes
<<<<<<<<<<<<<<<<<<<<<[-]>[-]<<[->+>+<<]>>[-<<+>>]<---------->>>>>>>>>>>>>[-]+<<<<<<<<<<<<<[[-]>>>>>>>>>>>>>[-]<<<<<<<<<<<<<]>>>>>>>>>>>>>[[-]<<<<<<<[-]+>>>>>>>]<<<<<<<<<<<<<[-]>[-]<<[->+>+<<]>>[-<<+>>]<------------->>>>>>>>>>>>>[-]+<<<<<<<<<<<<<[[-]>>>>>>>>>>>>>[-]<<<<<<<<<<<<<]>>>>>>>>>>>>>[[-]<<<<<<[-]+>>>>>>]<<<<<<<<<<<<<[-]>[-]<<[->+>+<<]>>[-<<+>>]<-------------------------------->>>>>>>>>>>>>[-]+<<<<<<<<<<<<<[[-]>>>>>>>>>>>>>[-]<<<<<<<<<<<<<]>>>>>>>>>>>>>[[-]<<<<<[-]+>>>>>]<<<<<<<<<<<<<[-]>[-]<<[->+>+<<]>>[-<<+>>]<--------->>>>>>>>>>>>>[-]+<<<<<<<<<<<<<[[-]>>>>>>>>>>>>>[-]<<<<<<<<<<<<<]>>>>>>>>>>>>>[[-]<<<<[-]+>>>>]<<<<<<<<<<<<<[-]>[-]<<[->+>+<<]>>[-<<+>>]<----------------------------------->>>>>>>>>>>>>[-]+<<<<<<<<<<<<<[[-]>>>>>>>>>>>>>[-]<<<<<<<<<<<<<]>>>>>>>>>>>>>[[-]<<<[-]+>>>]
# Recognize eight actual command bytes and loop direction
<<<<<<<<<<<<<[-]>[-]<<[->+>+<<]>>[-<<+>>]<------------------------------------------->>>>>>>>>>>>>[-]+<<<<<<<<<<<<<[[-]>>>>>>>>>>>>>[-]<<<<<<<<<<<<<]>>>>>>>>>>>>>[[-]<<[-]+>>]<<<<<<<<<<<<<[-]>[-]<<[->+>+<<]>>[-<<+>>]<--------------------------------------------->>>>>>>>>>>>>[-]+<<<<<<<<<<<<<[[-]>>>>>>>>>>>>>[-]<<<<<<<<<<<<<]>>>>>>>>>>>>>[[-]<<[-]+>>]<<<<<<<<<<<<<[-]>[-]<<[->+>+<<]>>[-<<+>>]<------------------------------------------------------------>>>>>>>>>>>>>[-]+<<<<<<<<<<<<<[[-]>>>>>>>>>>>>>[-]<<<<<<<<<<<<<]>>>>>>>>>>>>>[[-]<<[-]+>>]<<<<<<<<<<<<<[-]>[-]<<[->+>+<<]>>[-<<+>>]<-------------------------------------------------------------->>>>>>>>>>>>>[-]+<<<<<<<<<<<<<[[-]>>>>>>>>>>>>>[-]<<<<<<<<<<<<<]>>>>>>>>>>>>>[[-]<<[-]+>>]<<<<<<<<<<<<<[-]>[-]<<[->+>+<<]>>[-<<+>>]<------------------------------------------------------------------------------------------->>>>>>>>>>>>>[-]+<<<<<<<<<<<<<[[-]>>>>>>>>>>>>>[-]<<<<<<<<<<<<<]>>>>>>>>>>>>>[[-]<<[-]+>>>>>>>>>[-]+<<<<<<<]<<<<<<<<<<<<<[-]>[-]<<[->+>+<<]>>[-<<+>>]<--------------------------------------------------------------------------------------------->>>>>>>>>>>>>[-]+<<<<<<<<<<<<<[[-]>>>>>>>>>>>>>[-]<<<<<<<<<<<<<]>>>>>>>>>>>>>[[-]<<[-]+>>>>>>>>>>[-]+<<<<<<<<]<<<<<<<<<<<<<[-]>[-]<<[->+>+<<]>>[-<<+>>]<---------------------------------------------->>>>>>>>>>>>>[-]+<<<<<<<<<<<<<[[-]>>>>>>>>>>>>>[-]<<<<<<<<<<<<<]>>>>>>>>>>>>>[[-]<<[-]+>>]<<<<<<<<<<<<<[-]>[-]<<[->+>+<<]>>[-<<+>>]<-------------------------------------------->>>>>>>>>>>>>[-]+<<<<<<<<<<<<<[[-]>>>>>>>>>>>>>[-]<<<<<<<<<<<<<]>>>>>>>>>>>>>[[-]<<[-]+>>]
