# MODULE counted source dynamic guest tape interpreter
# PURPOSE execute all eight commands with capacity backed guest growth
# INPUT source count in two bytes then fuel in four bytes then capacity in two bytes
# INPUT normalized source bytes followed by raw guest input
# OUTPUT guest bytes followed by one provisional diagnostic status
# PROFILE unsigned wrapping bytes and zero on guest EOF
# STATUS zero success four left five right six fuel thirteen source
# LIMITATION complete physical input and host closure are external obligations
# LIMITATION original annotated offsets and authoritative framing are not implemented
# TAPE anchor cells one and two are source count
# TAPE anchor cells three through six are fuel and seven is status
# TAPE anchor eight is opcode and nine through thirteen are scratch
# TAPE anchor fourteen is continuation and fifteen is execution gate
# TAPE records start at sixteen with stride sixteen
# TAPE record zero backlink one opcode two source prefix three guest prefix
# TAPE record four guest data five capacity marker six through thirteen scratch
# TAPE record fourteen and fifteen hold mobile source counters during admission
# TAPE record fifteen in the first record is the guest origin after admission
# CAPACITY encoded zero denotes sixty five thousand five hundred thirty six cells
# COST capacity markers are prepared eagerly and guest data starts at zero
# PROVENANCE handwritten BF with no foreign source layout generator

# Read the fixed request header
>,>,>,>,>,>,>>>>>>>>,>,

# Move capacity to the first record and enter a counted do loop
<[->>>>>>>> >>>>>>>>+<<<<<<<< <<<<<<<<]
>[->>>>>>>> >>>>>>>>+<<<<<<<< <<<<<<<<]
>>>>>>>> >>>>>>>> <<<<+
[
  [-]
  <<<<<<<< <<<[-]+>>>>>[-]+>>>>>>>>>-

  # Borrow into the high capacity byte when the original low byte was zero
  [-<<<<<<<<+>+>>>>>>>]<<<<<<<[->>>>>>>+<<<<<<<]<+
  >>+<<[[-]>>[-]<<]>>[[-]>>>>>>>-<<<<<<<]

  # Carry remaining capacity to the next record
  >>>>>>[->>>>>>>> >>>>>>>>+<<<<<<<< <<<<<<<<]
  >[->>>>>>>> >>>>>>>>+<<<<<<<< <<<<<<<<]
  >>>>>>>> >>>>>>>> <
  <<<<<<<< <<<<<<[-]+>>>>>>>> >>>[-]

  # Continue while either remaining capacity byte is nonzero
  >>>[-<<<<<<<<+>+>>>>>>>]<<<<<<<[->>>>>>>+<<<<<<<]<
  [[-]>>>>>[-]+<<<<<]
  >>>>>>>>>[-<<<<<<<<<+>+>>>>>>>>]<<<<<<<<[->>>>>>>>+<<<<<<<<]<
  [[-]>>>>>[-]+<<<<<]>>>>>
]
<<<<<<<< <<<[<<<<<<<< <<<<<<<<]

# Move source count to the first source record
>[->>>>>>>> >>>>>>>> >>>>>>>> >>>>>+<<<<<<<< <<<<<<<< <<<<<<<< <<<<<]
>[->>>>>>>> >>>>>>>> >>>>>>>> >>>>>+<<<<<<<< <<<<<<<< <<<<<<<< <<<<<]
>>>>>>>> >>>>>>>> >>>>>>>> >[-]
>>>[-<<<<<<<<+>+>>>>>>>]<<<<<<<[->>>>>>>+<<<<<<<]<
[[-]>>>>>[-]+<<<<<]
>>>>>>>>>[-<<<<<<<<<+>+>>>>>>>>]<<<<<<<<[->>>>>>>>+<<<<<<<<]<
[[-]>>>>>[-]+<<<<<]>>>>>

# Admit the entire counted source before executing any command
[
  [-]<<<<<,

  # Decode addition
  -------------------------------------------
  [->+>+<<]>>[-<<+>>]< >>+<<[[-]>>[-]<<]
  >>[[-]<<<<<<<<+>>>>>>>>]<<<

  # Decode input
  -[->+>+<<]>>[-<<+>>]< >>+<<[[-]>>[-]<<]
  >>[[-]<<<<<<<<++++++>>>>>>>>]<<<

  # Decode subtraction
  -[->+>+<<]>>[-<<+>>]< >>+<<[[-]>>[-]<<]
  >>[[-]<<<<<<<<++>>>>>>>>]<<<

  # Decode output
  -[->+>+<<]>>[-<<+>>]< >>+<<[[-]>>[-]<<]
  >>[[-]<<<<<<<<+++++>>>>>>>>]<<<

  # Decode left movement
  --------------[->+>+<<]>>[-<<+>>]< >>+<<[[-]>>[-]<<]
  >>[[-]<<<<<<<<++++>>>>>>>>]<<<

  # Decode right movement
  --[->+>+<<]>>[-<<+>>]< >>+<<[[-]>>[-]<<]
  >>[[-]<<<<<<<<+++>>>>>>>>]<<<

  # Decode opening bracket
  -----------------------------[->+>+<<]>>[-<<+>>]< >>+<<[[-]>>[-]<<]
  >>[[-]<<<<<<<<+++++++>>>>>>>>]<<<

  # Decode closing bracket
  --[->+>+<<]>>[-<<+>>]< >>+<<[[-]>>[-]<<]
  >>[[-]<<<<<<<<++++++++>>>>>>>>]<<<[-]

  # Latch an unknown source byte without any guest effects
  <<<<<[->>>>>>+>+<<<<<<<]>>>>>>>[-<<<<<<<+>>>>>>>]<
  >>+<<[[-]>>[-]<<]>>[[-]>[-]+<]

  # Opening bracket increments the sixteen bit preflight depth
  <<<<<<<<[->>>>>+>+<<<<<<]>>>>>>[-<<<<<<+>>>>>>]<-------
  >>>+<<<[[-]>>>[-]<<<]>>>[
    [-]>>>+[-<<<<<<+>+>>>>>]<<<<<[->>>>>+<<<<<]<
    >>+<<[[-]>>[-]<<]>>[[-]>>>>>+<<<<<]>
  ]

  # Closing bracket requires a nonzero depth before decrementing it
  <<<<<<<<[->>>>>+>+<<<<<<]>>>>>>[-<<<<<<+>>>>>>]<--------
  >>>+<<<[[-]>>>[-]<<<]>>>[
    [-]+<+>>>>[-<<<<<<+>+>>>>>]<<<<<[->>>>>+<<<<<]<
    [[-]>>[-]<<]
    >>>>>>>[-<<<<<<<+>+>>>>>>]<<<<<<[->>>>>>+<<<<<<]<
    [[-]>>[-]<<]>>[[-]>>[-]+<[-]<]>
    [
      [-]>>>-[-<<<<<<+>+>>>>>]<<<<<[->>>>>+<<<<<]<+
      >>+<<[[-]>>[-]<<]>>[[-]>>>>>-<<<<<]>
    ]
  ]

  # Decrement remaining source count
  >>>>>-[-<<<<<<<<+>+>>>>>>>]<<<<<<<[->>>>>>>+<<<<<<<]<+
  >>+<<[[-]>>[-]<<]>>[[-]>>>>>>>-<<<<<<<]

  # Move error depth and remaining count to the next record
  >>[->>>>>>>> >>>>>>>>+<<<<<<<< <<<<<<<<]
  >>[->>>>>>>> >>>>>>>>+<<<<<<<< <<<<<<<<]
  >[->>>>>>>> >>>>>>>>+<<<<<<<< <<<<<<<<]
  >[->>>>>>>> >>>>>>>>+<<<<<<<< <<<<<<<<]
  >[->>>>>>>> >>>>>>>>+<<<<<<<< <<<<<<<<]
  >>>>>>>> >>>>>>>> <
  <<<<<<<< <<<<<<[-]+>>>>>>>> >>>[-]
  >>>[-<<<<<<<<+>+>>>>>>>]<<<<<<<[->>>>>>>+<<<<<<<]<
  [[-]>>>>>[-]+<<<<<]
  >>>>>>>>>[-<<<<<<<<<+>+>>>>>>>>]<<<<<<<<[->>>>>>>>+<<<<<<<<]<
  [[-]>>>>>[-]+<<<<<]>>>>>
]

# Remaining open brackets also reject the source
>[-<<<<<<+>+>>>>>]<<<<<[->>>>>+<<<<<]<[[-]>>>>[-]+<<<<]
>>>>>>>[-<<<<<<<+>+>>>>>>]<<<<<<[->>>>>>+<<<<<<]<[[-]>>>>[-]+<<<<]
>>>>[
  [-]<<<<<<<<<<[<<<<<<<< <<<<<<<<]>>>>>>>[-]+++++++++++++>>>[-]
]
<<<<<<<<<<[<<<<<<<< <<<<<<<<]

# Install the checked guest origin marker
>>>>>>>> >>>>>>>> >>>>>>>> >>>>>>>+
<<<<<<<< <<<<<<<[<<<<<<<< <<<<<<<<]

# Enter execution only if preflight succeeded
>>>>>>>[->>>>+>+<<<<<]>>>>>[-<<<<<+>>>>>]<
>>>+<<<[[-]>>>[-]<<<]>>>
[
  [-]

  # Fetch the current opcode through the source prefix chain
  <<<<<<<< <<<<<<>>>>>>>> >>>>>>>> >>[>>>>>>>> >>>>>>>>]<
  [->>>>>>>> >>>+>+<<<<<<<< <<<<]
  >>>>>>>> >>>>[-<<<<<<<< <<<<+>>>>>>>> >>>>]<
  <<<<<<<< <<<<[
    >>>>>>>> >>>>[-<<<<<<<< <<<<<<<<+>>>>>>>> >>>>>>>>]
    <<<<<<<< <<<< <<<<<<<< <<<<<<<<
  ]
  >>>>>>>> >>>>[-<<<<+>>>>]
  <<<<[->>>+>+<<<<]>>>>[-<<<<+>>>>]<[[-]>>>>+<<<<]

  # Test all four fuel bytes without wrapping a sum
  <<<<<<<<[->>>>>>>>>+>+<<<<<<<<<<]>>>>>>>>>>[-<<<<<<<<<<+>>>>>>>>>>]<
  [[-]<[-]+>]
  <<<<<<<<[->>>>>>>>+>+<<<<<<<<<]>>>>>>>>>[-<<<<<<<<<+>>>>>>>>>]<
  [[-]<[-]+>]
  <<<<<<<[->>>>>>>+>+<<<<<<<<]>>>>>>>>[-<<<<<<<<+>>>>>>>>]<
  [[-]<[-]+>]
  <<<<<<[->>>>>>+>+<<<<<<<]>>>>>>>[-<<<<<<<+>>>>>>>]<
  [[-]<[-]+>]
  <<+>[[-]<[-]>]<[
    [-]>>>>>[[-]<<<<<<<<[-]++++++>>>>>>>>]<<<<<
  ]

  # A nonempty program with available fuel executes one original command
  >>>>>[
    [-]<<<<<<<< <<<<-
    [->>>>>>>>>+>+<<<<<<<<<<]>>>>>>>>>>[-<<<<<<<<<<+>>>>>>>>>>]<+
    <<<+>>>[[-]<<<[-]>>>]<<<
    [
      [-]<<<<<-[->>>>>>>>+>+<<<<<<<<<]>>>>>>>>>[-<<<<<<<<<+>>>>>>>>>]<+
      <<+>>[[-]<<[-]>>]<<<
    ]
    >[
      [-]<<<<<-[->>>>>>>+>+<<<<<<<<]>>>>>>>>[-<<<<<<<<+>>>>>>>>]<+
      <+>[[-]<[-]>]<<
    ]
    >[[-]<<<<<->>>>>]
    <<<

    # Addition uses the current guest record
    -[->>>>+>+<<<<<]>>>>>[-<<<<<+>>>>>]<
    <<<+>>>[[-]<<<[-]>>>]<<<[
      [-]<<<<<<<<<>>>>>>>> >>>>>>>> >>>[>>>>>>>> >>>>>>>>]>+
      <<<<[<<<<<<<< <<<<<<<<]>>>>>>>> >
    ]<

    # Subtraction uses the current guest record
    -[->>>>+>+<<<<<]>>>>>[-<<<<<+>>>>>]<
    <<<+>>>[[-]<<<[-]>>>]<<<[
      [-]<<<<<<<<<>>>>>>>> >>>>>>>> >>>[>>>>>>>> >>>>>>>>]>-
      <<<<[<<<<<<<< <<<<<<<<]>>>>>>>> >
    ]<

    # Right movement checks the next record before extending the guest prefix
    -[->>>>+>+<<<<<]>>>>>[-<<<<<+>>>>>]<
    <<<+>>>[[-]<<<[-]>>>]<<<[
      [-]<<<<<<<<<>>>>>>>> >>>>>>>> >>>[>>>>>>>> >>>>>>>>]
      >>>>>>>> >>>>>>>> >>[->+>+<<]>>[-<<+>>]< >>+<<
      [
        [-]>>[-]<<<<<<<< <<<<<<<< <<<<<+>>>>>>>> >>>>>>>> >>>
      ]
      >>[
        [-]<<<<<<<<[<<<<<<<< <<<<<<<<]>>>>>>>[-]+++++>[-]
      ]
      <<<<<<<<[<<<<<<<< <<<<<<<<]>>>>>>>> >
    ]<

    # Left movement checks the explicit first guest record marker
    -[->>>>+>+<<<<<]>>>>>[-<<<<<+>>>>>]<
    <<<+>>>[[-]<<<[-]>>>]<<<[
      [-]<<<<<<<<<>>>>>>>> >>>>>>>> >>>[>>>>>>>> >>>>>>>>]
      >>>>>>>> >>>>[-<<<<<<<<<+>+>>>>>>>>]<<<<<<<<[->>>>>>>>+<<<<<<<<]<
      >>+<<[[-]>>[-]>+<<<]
      >>[
        [-]<<<<<<<< <<<<<<<< <<<<<[-]>>>>>>>> >>>>>>>> >>>>>
      ]
      >[
        [-]<<<<<<<<<[<<<<<<<< <<<<<<<<]>>>>>>>[-]++++>>[-]
      ]
      <<<<<<<<<[<<<<<<<< <<<<<<<<]>>>>>>>> >
    ]<

    # Output preserves every byte value
    -[->>>>+>+<<<<<]>>>>>[-<<<<<+>>>>>]<
    <<<+>>>[[-]<<<[-]>>>]<<<[
      [-]<<<<<<<<<>>>>>>>> >>>>>>>> >>>[>>>>>>>> >>>>>>>>]>.
      <<<<[<<<<<<<< <<<<<<<<]>>>>>>>> >
    ]<

    # Input inherits the declared zero at EOF root configuration
    -[->>>>+>+<<<<<]>>>>>[-<<<<<+>>>>>]<
    <<<+>>>[[-]<<<[-]>>>]<<<[
      [-]<<<<<<<<<>>>>>>>> >>>>>>>> >>>[>>>>>>>> >>>>>>>>]>,
      <<<<[<<<<<<<< <<<<<<<<]>>>>>>>> >
    ]<

    # An opening bracket skips forward only for a zero guest value
    -[->>>>+>+<<<<<]>>>>>[-<<<<<+>>>>>]<
    <<<+>>>[[-]<<<[-]>>>]<<<[
      [-]<<<<<<<<<>>>>>>>> >>>>>>>> >>>[>>>>>>>> >>>>>>>>]>
      [->>>>>>>>+>+<<<<<<<<<]>>>>>>>>>[-<<<<<<<<<+>>>>>>>>>]<
      <<<<<<<< <<<<[
        >>>>>>>> >>>>[-<<<<<<<< <<<<<<<<+>>>>>>>> >>>>>>>>]
        <<<<<<<< <<<< <<<<<<<< <<<<<<<<
      ]
      >>>>>>>> >>>><<<+>>>[[-]<<<[-]>>>]<<<[
        [-]<<<<<<<<<>>>>>>>> >>>>>>>> >>[>>>>>>>> >>>>>>>>]+
        >>>>>>+[->>>>>>>> >>>>>>>>+<<<<<<<< <<<<<<<<]
        >[->>>>>>>> >>>>>>>>+<<<<<<<< <<<<<<<<]
        >>>>>>>> >>>>>>>> >>+
        [
          [-]<<<<<<<<<<[->>>>>+>+<<<<<<]>>>>>>[-<<<<<<+>>>>>>]<-------
          >>>>+<<<<[[-]>>>>[-]<<<<]>>>>[
            [-]<<+[-<<+>+>]<[->+<]<
            >>>>>+<<<<<[[-]>>>>>[-]<<<<<]>>>>>[[-]<<+>>]<
          ]
          <<<<<<<<<[->>>>>+>+<<<<<<]>>>>>>[-<<<<<<+>>>>>>]<--------
          >>>>+<<<<[[-]>>>>[-]<<<<]>>>>[
            [-]<<-[-<<+>+>]<[->+<]<+
            >>>>>+<<<<<[[-]>>>>>[-]<<<<<]>>>>>[[-]<<->>]<
          ]
          <<[-<<+>+>]<[->+<]<[[-]>>>>>[-]+<<<<<]
          >>>[-<<<+>+>>]<<[->>+<<]<[[-]>>>>>[-]+<<<<<]>>>>>
          [-<+>>+<]>[-<+>]<<[
            [-]>[-]<<<<<<<<<+>>>>>>
            [->>>>>>>> >>>>>>>>+<<<<<<<< <<<<<<<<]
            >[->>>>>>>> >>>>>>>>+<<<<<<<< <<<<<<<<]
            >>>>>>>> >>>>>>>> >>+<
          ]>
        ]
        <<<<<<<< <<<[<<<<<<<< <<<<<<<<]>>>>>>>> >
      ]
    ]<

    # A closing bracket scans backward only for a nonzero guest value
    -[->>>>+>+<<<<<]>>>>>[-<<<<<+>>>>>]<
    <<<+>>>[[-]<<<[-]>>>]<<<[
      [-]<<<<<<<<<>>>>>>>> >>>>>>>> >>>[>>>>>>>> >>>>>>>>]>
      [->>>>>>>>+>+<<<<<<<<<]>>>>>>>>>[-<<<<<<<<<+>>>>>>>>>]<
      <<<<<<<< <<<<[
        >>>>>>>> >>>>[-<<<<<<<< <<<<<<<<+>>>>>>>> >>>>>>>>]
        <<<<<<<< <<<< <<<<<<<< <<<<<<<<
      ]
      >>>>>>>> >>>>[
        [-]<<<<<<<< <<<<>>>>>>>> >>>>>>>> >>[>>>>>>>> >>>>>>>>]
        >>>>>>+[-<<<<<<<< <<<<<<<<+>>>>>>>> >>>>>>>>]
        >[-<<<<<<<< <<<<<<<<+>>>>>>>> >>>>>>>>]
        <<<<<<<< <<<<<<<< <<<<<<<[-]>>>>>>>>>+
        [
          [-]<<<<<<<<<<[->>>>>+>+<<<<<<]>>>>>>[-<<<<<<+>>>>>>]<-------
          >>>>+<<<<[[-]>>>>[-]<<<<]>>>>[
            [-]<<-[-<<+>+>]<[->+<]<+
            >>>>>+<<<<<[[-]>>>>>[-]<<<<<]>>>>>[[-]<<->>]<
          ]
          <<<<<<<<<[->>>>>+>+<<<<<<]>>>>>>[-<<<<<<+>>>>>>]<--------
          >>>>+<<<<[[-]>>>>[-]<<<<]>>>>[
            [-]<<+[-<<+>+>]<[->+<]<
            >>>>>+<<<<<[[-]>>>>>[-]<<<<<]>>>>>[[-]<<+>>]<
          ]
          <<[-<<+>+>]<[->+<]<[[-]>>>>>[-]+<<<<<]
          >>>[-<<<+>+>>]<<[->>+<<]<[[-]>>>>>[-]+<<<<<]>>>>>
          [-<+>>+<]>[-<+>]<<[
            [-]>[-]<<<
            [-<<<<<<<< <<<<<<<<+>>>>>>>> >>>>>>>>]
            >[-<<<<<<<< <<<<<<<<+>>>>>>>> >>>>>>>>]
            <<<<<<<< <<<<<<<< <<<<<<<[-]>>>>>>>> >+<
          ]>
        ]
        <<<<<<<< <<<[<<<<<<<< <<<<<<<<]>>>>>>>> >>>>
      ]<<<
    ]<[-]

    # Advance only after a successful command
    <[->>>>>+>+<<<<<<]>>>>>>[-<<<<<<+>>>>>>]<
    >>+<<[[-]>>[-]<<]>>[-<<+>+>]<[->+<]<[
      [-]<<<<<<<< <<<<>>>>>>>> >>>>>>>> >>[>>>>>>>> >>>>>>>>]+
      <<[<<<<<<<< <<<<<<<<]>>>>>>>> >>>>
    ]>>>
  ]<
]

# Report provisional completion separately from guest bytes
<<<<<<<.
