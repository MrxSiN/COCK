# MODULE ZIP reflected CRC thirty two
# PURPOSE compute real CRC over arbitrary binary chunks entirely in BF
# INPUT repeated unsigned two byte chunk length and exact raw chunk bytes
# INPUT zero length chunk then hexadecimal A5 guard ends the message
# OUTPUT zero status then four little endian finalized CRC bytes
# OUTPUT eleven alone on invalid final guard
# PROFILE reflected EDB88320 polynomial initial and final all ones
# TAPE one and two chunk count three byte four parity five quotient
# TAPE six division flag seven bit count eight byte loop nine chunk loop
# TAPE twelve XOR decision thirteen scratch fourteen output gate
# TAPE thirty two through sixty three hold CRC bits from least significant
# TAPE sixty four toggle scratch sixty five output byte
# LIMITATION independent actual chunk counts read close and final closure required
# LIMITATION no fixed total message size limit is imposed by chunk length

# Initialize the complete polynomial register to all ones
>>>>>>>> >>>>>>>> >>>>>>>> >>>>>>>>
+>+>+>+>+>+>+>+>
+>+>+>+>+>+>+>+>
+>+>+>+>+>+>+>+>
+>+>+>+>+>+>+>+>
<<<<<<<< <<<<<<<< <<<<<<<< <<<<<<<< <<<<<<<< <<<<<<<< <<<<<<<< <<<<<<<<

# Read chunks until an explicit zero length descriptor
>>>>>>>> >+
[
  [-]<<<<<<<<[-],>[-],<
  [->>+>+<<<]>>>[-<<<+>>>]<[[-]>>>>>[-]+<<<<<]
  <[->+>+<<]>>[-<<+>>]<[[-]>>>>>[-]+<<<<<]>>>>>
  [
    [-]>[-]+<<<<<<,
    >>>>[-]++++++++
    [
      # Divide the current byte by two retaining its low bit
      <<<<[
        ->>>+<<
        [->+>[-]<<]
        >>[[-]<<+>>]<<<
      ]
      >>[-<<+>>]

      # Add input parity and old CRC low bit then reduce modulo two
      <[->>>>>>>>+<<<<<<<<]
      >>>>>>>> >>>>>>>> >>>>>>>> >>>>
      [-<<<<<<<< <<<<<<<< <<<<+>>>>>>>> >>>>>>>> >>>>]
      <<<<<<<< <<<<<<<< <<<<
      ->+<[[-]>[-]<]>[-<+>]

      # Shift the polynomial register right by exactly one bit
      >>>>>>>> >>>>>>>> >>>>
      [-<+>]>[-<+>]>[-<+>]>[-<+>]>[-<+>]>[-<+>]>[-<+>]>[-<+>]>
      [-<+>]>[-<+>]>[-<+>]>[-<+>]>[-<+>]>[-<+>]>[-<+>]>[-<+>]>
      [-<+>]>[-<+>]>[-<+>]>[-<+>]>[-<+>]>[-<+>]>[-<+>]>[-<+>]>
      [-<+>]>[-<+>]>[-<+>]>[-<+>]>[-<+>]>[-<+>]>[-<+>]>
      <<<<<<<< <<<<<<<< <<<<<<<< <<<<<<<< <<<<<<<< <<<<<<<< <<<<

      # Apply every set bit of the reflected polynomial on an odd decision
      [
        [-]>>>>>>>> >>>>>>>> >>>>>>>> >>>>>>>> >>>>>>>> >>>>>>>> >>>>

        # Polynomial bit five
        <<<<<<<< <<<<<<<< <<<<<<<< <<<
        [->>>>>>>> >>>>>>>> >>>>>>>> >>>+<<<<<<<< <<<<<<<< <<<<<<<< <<<]+
        >>>>>>>> >>>>>>>> >>>>>>>> >>>[-<<<<<<<< <<<<<<<< <<<<<<<< <<<->>>>>>>> >>>>>>>> >>>>>>>> >>>]

        # Polynomial bit eight
        <<<<<<<< <<<<<<<< <<<<<<<<
        [->>>>>>>> >>>>>>>> >>>>>>>>+<<<<<<<< <<<<<<<< <<<<<<<<]+
        >>>>>>>> >>>>>>>> >>>>>>>>[-<<<<<<<< <<<<<<<< <<<<<<<<->>>>>>>> >>>>>>>> >>>>>>>>]

        # Polynomial bit nine
        <<<<<<<< <<<<<<<< <<<<<<<
        [->>>>>>>> >>>>>>>> >>>>>>>+<<<<<<<< <<<<<<<< <<<<<<<]+
        >>>>>>>> >>>>>>>> >>>>>>>[-<<<<<<<< <<<<<<<< <<<<<<<->>>>>>>> >>>>>>>> >>>>>>>]

        # Polynomial bit fifteen
        <<<<<<<< <<<<<<<< <
        [->>>>>>>> >>>>>>>> >+<<<<<<<< <<<<<<<< <]+
        >>>>>>>> >>>>>>>> >[-<<<<<<<< <<<<<<<< <->>>>>>>> >>>>>>>> >]

        # Polynomial bit nineteen
        <<<<<<<< <<<<<
        [->>>>>>>> >>>>>+<<<<<<<< <<<<<]+
        >>>>>>>> >>>>>[-<<<<<<<< <<<<<->>>>>>>> >>>>>]

        # Polynomial bit twenty
        <<<<<<<< <<<<
        [->>>>>>>> >>>>+<<<<<<<< <<<<]+
        >>>>>>>> >>>>[-<<<<<<<< <<<<->>>>>>>> >>>>]

        # Polynomial bit twenty one
        <<<<<<<< <<<
        [->>>>>>>> >>>+<<<<<<<< <<<]+
        >>>>>>>> >>>[-<<<<<<<< <<<->>>>>>>> >>>]

        # Polynomial bit twenty three
        <<<<<<<< <
        [->>>>>>>> >+<<<<<<<< <]+
        >>>>>>>> >[-<<<<<<<< <->>>>>>>> >]

        # Polynomial bit twenty four
        <<<<<<<<
        [->>>>>>>>+<<<<<<<<]+
        >>>>>>>>[-<<<<<<<<->>>>>>>>]

        # Polynomial bit twenty six
        <<<<<<
        [->>>>>>+<<<<<<]+
        >>>>>>[-<<<<<<->>>>>>]

        # Polynomial bit twenty seven
        <<<<<
        [->>>>>+<<<<<]+
        >>>>>[-<<<<<->>>>>]

        # Polynomial bit twenty nine
        <<<
        [->>>+<<<]+
        >>>[-<<<->>>]

        # Polynomial bit thirty
        <<
        [->>+<<]+
        >>[-<<->>]

        # Polynomial bit thirty one
        <
        [->+<]+
        >[-<->]

        <<<<<<<< <<<<<<<< <<<<<<<< <<<<<<<< <<<<<<<< <<<<<<<< <<<<
      ]
      <<<<<-
    ]

    # Decrement the two byte chunk count without wrapping its high byte
    <<<<<<[->>+>+<<<]>>>[-<<<+>>>]<
    >>+<<[[-]>>[-]<<]>>
    <<<<->>>>
    [[-]<<<->>>]

    # Continue the current chunk while either count byte remains
    <<<<[->>+>+<<<]>>>[-<<<+>>>]<[[-]>>>>>[-]+<<<<<]
    <[->+>+<<]>>[-<<+>>]<[[-]>>>>>[-]+<<<<<]>>>>>
  ]>
]

