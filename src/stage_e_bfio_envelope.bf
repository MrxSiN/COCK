# MODULE complete BFIO v1 envelope validator
# PURPOSE validate the real frame header full width length payload and guard
# INPUT exactly one BFIO envelope with all binary payload values permitted
# OUTPUT zero valid ten total length overflow eleven malformed twelve unsupported
# TAPE one through eight unsigned little endian payload count
# TAPE nine byte ten and eleven copies twelve zero thirteen continuation
# TAPE fourteen kind admission twenty four malformed twenty five unsupported
# TAPE twenty six overflow twenty seven high bytes flag thirty execution gate
# PROFILE accepts kinds one through six version one minor zero flags zero
# PROFILE correlation bytes are opaque and never authenticate the producer
# REQUIREMENT independent exact total bytes read close and no trailing bytes
# LIMITATION this is an envelope check not a selected session or completion check

# Check all four fixed magic bytes
>>>>>>>> >,
---------- ---------- ---------- ---------- ---------- ---------- ------
[[-]>>>>>>>> >>>>>>>[-]+<<<<<<<< <<<<<<<]
,
---------- ---------- ---------- ---------- ---------- ---------- ----------
[[-]>>>>>>>> >>>>>>>[-]+<<<<<<<< <<<<<<<]
,
---------- ---------- ---------- ---------- ---------- ---------- ---------- ---
[[-]>>>>>>>> >>>>>>>[-]+<<<<<<<< <<<<<<<]
,
---------- ---------- ---------- ---------- ---------- ---------- ---------- ---------
[[-]>>>>>>>> >>>>>>>[-]+<<<<<<<< <<<<<<<]

# Version mismatch is distinct from malformed fixed fields
,-[[-]>>>>>>>> >>>>>>>>[-]+<<<<<<<< <<<<<<<<]
,[[-]>>>>>>>> >>>>>>>>[-]+<<<<<<<< <<<<<<<<]

# Admit exactly the six existing kind values
,-
[->+>+<<]>>[-<<+>>]< >>+<<[[-]>>[-]<<]>>[[-]>>[-]+<<]<<<
-[->+>+<<]>>[-<<+>>]< >>+<<[[-]>>[-]<<]>>[[-]>>[-]+<<]<<<
-[->+>+<<]>>[-<<+>>]< >>+<<[[-]>>[-]<<]>>[[-]>>[-]+<<]<<<
-[->+>+<<]>>[-<<+>>]< >>+<<[[-]>>[-]<<]>>[[-]>>[-]+<<]<<<
-[->+>+<<]>>[-<<+>>]< >>+<<[[-]>>[-]<<]>>[[-]>>[-]+<<]<<<
-[->+>+<<]>>[-<<+>>]< >>+<<[[-]>>[-]<<]>>[[-]>>[-]+<<]<<<[-]
>>>>> >+<[[-]>[-]<]>[[-]>>>>>>>>>>[-]+<<<<<<<<<<]
<<<<<<,[[-]>>>>>>>> >>>>>>>[-]+<<<<<<<< <<<<<<<]

# Retain all eight length bytes without narrowing
<<<<<<<<,>,>,>,>,>,>,>,

# Correlation identifier is exactly eight uninterpreted bytes
>,[-],[-],[-],[-],[-],[-],[-],[-]

# Detect checked total overflow before attempting an impossible payload
>>>>>>>> >>>>>>>> >>+
<<<<<<<< <<<<<<<< <<<<<<<< <
[->>>>>>>+>+<<<<<<<<]>>>>>>>>[-<<<<<<<<+>>>>>>>>]<
+[[-]>>>>>>>> >>>>>>>> >>[-]<<<<<<<< <<<<<<<< <<]
<<<<<<[->>>>>>+>+<<<<<<<]>>>>>>>[-<<<<<<<+>>>>>>>]<
+[[-]>>>>>>>> >>>>>>>> >>[-]<<<<<<<< <<<<<<<< <<]
<<<<<[->>>>>+>+<<<<<<]>>>>>>[-<<<<<<+>>>>>>]<
+[[-]>>>>>>>> >>>>>>>> >>[-]<<<<<<<< <<<<<<<< <<]
<<<<[->>>>+>+<<<<<]>>>>>[-<<<<<+>>>>>]<
+[[-]>>>>>>>> >>>>>>>> >>[-]<<<<<<<< <<<<<<<< <<]
<<<[->>>+>+<<<<]>>>>[-<<<<+>>>>]<
+[[-]>>>>>>>> >>>>>>>> >>[-]<<<<<<<< <<<<<<<< <<]
<<[->>+>+<<<]>>>[-<<<+>>>]<
+[[-]>>>>>>>> >>>>>>>> >>[-]<<<<<<<< <<<<<<<< <<]
<[->+>+<<]>>[-<<+>>]<
+[[-]>>>>>>>> >>>>>>>> >>[-]<<<<<<<< <<<<<<<< <<]
>>>>>>>> >>>>>>>> >>[
  [-]>>>>+++++++++++[-<<<+++++++++++++++++++++>>>]
  <<<<<<<< <<<<<<<< <<<<<<<< <<<<<<
  [->>>>>>>>+>+<<<<<<<<<]>>>>>>>>>[-<<<<<<<<<+>>>>>>>>>]<
  >>>>>>>> >>>>>>>> >>>[
    -<<<<<<<< <<<<<<<< <<<
    [->+>+<<]>>[-<<+>>]<
    >>+<<[[-]>>[-]<<]>>
    [[-]>>>>>>>> >>>>>>>>[-]>[-]+<<<<<<<< <<<<<<<<<]
    <<<->>>>>>>> >>>>>>>> >>>
  ]
  >>>+<<[[-]>>[-]<<]>>[[-]<<<<<[-]+>>>>>]
  <<<<
]

# Fail header admission without exposing any successful partial parse
>>>+
<<<<[
  [-]<<<<<<<< <<<<<<<< <<<<<<<< <<[-]+++++ +++++
  >>>>>>>> >>>>>>>> >>>>>>>> >>>>>>[-]<<<<
]
<[
  [-]<<<<<<<< <<<<<<<< <<<<<<<< <[-]+++++ +++++ ++
  >>>>>>>> >>>>>>>> >>>>>>>> >>>>>>[-]<<<<<
]
<[
  [-]<<<<<<<< <<<<<<<< <<<<<<<<[-]+++++ +++++ +
  >>>>>>>> >>>>>>>> >>>>>>>> >>>>>>[-]<<<<<<
]
>>>>>>[
  [-]

  # Determine whether any byte of the full width counter remains
  <<<<<<<< <<<<<<<< <<<<<<<< <<<<<
  [->>>>>>>>>+>+<<<<<<<<<<]>>>>>>>>>>[-<<<<<<<<<<+>>>>>>>>>>]<[[-]>>>[-]+<<<]
  <<<<<<<<[->>>>>>>>+>+<<<<<<<<<]>>>>>>>>>[-<<<<<<<<<+>>>>>>>>>]<[[-]>>>[-]+<<<]
  <<<<<<<[->>>>>>>+>+<<<<<<<<]>>>>>>>>[-<<<<<<<<+>>>>>>>>]<[[-]>>>[-]+<<<]
  <<<<<<[->>>>>>+>+<<<<<<<]>>>>>>>[-<<<<<<<+>>>>>>>]<[[-]>>>[-]+<<<]
  <<<<<[->>>>>+>+<<<<<<]>>>>>>[-<<<<<<+>>>>>>]<[[-]>>>[-]+<<<]
  <<<<[->>>>+>+<<<<<]>>>>>[-<<<<<+>>>>>]<[[-]>>>[-]+<<<]
  <<<[->>>+>+<<<<]>>>>[-<<<<+>>>>]<[[-]>>>[-]+<<<]
  <<[->>+>+<<<]>>>[-<<<+>>>]<[[-]>>>[-]+<<<]>>>
  [
    [-]<<<<,[-]

    # Charge one opaque payload byte with full width borrow
    <<<<<<<<[->>>>>>>>>+>+<<<<<<<<<<]>>>>>>>>>>[-<<<<<<<<<<+>>>>>>>>>>]<
    >>+<<[[-]>>[-]<<]>>
    <<<<<<<< <<<->>>>>>>> >>>
    [
      [-]<<<<<<<< <<[->>>>>>>>+>+<<<<<<<<<]>>>>>>>>>[-<<<<<<<<<+>>>>>>>>>]<
      >>+<<[[-]>>[-]<<]>>
      <<<<<<<< <<->>>>>>>> >>
      [
        [-]<<<<<<<< <[->>>>>>>+>+<<<<<<<<]>>>>>>>>[-<<<<<<<<+>>>>>>>>]<
        >>+<<[[-]>>[-]<<]>>
        <<<<<<<< <->>>>>>>> >
        [
          [-]<<<<<<<<[->>>>>>+>+<<<<<<<]>>>>>>>[-<<<<<<<+>>>>>>>]<
          >>+<<[[-]>>[-]<<]>>
          <<<<<<<<->>>>>>>>
          [
            [-]<<<<<<<[->>>>>+>+<<<<<<]>>>>>>[-<<<<<<+>>>>>>]<
            >>+<<[[-]>>[-]<<]>>
            <<<<<<<->>>>>>>
            [
              [-]<<<<<<[->>>>+>+<<<<<]>>>>>[-<<<<<+>>>>>]<
              >>+<<[[-]>>[-]<<]>>
              <<<<<<->>>>>>
              [
                [-]<<<<<[->>>+>+<<<<]>>>>[-<<<<+>>>>]<
                >>+<<[[-]>>[-]<<]>>
                <<<<<->>>>>
                [[-]<<<<->>>>]
              ]
            ]
          ]
        ]
      ]
    ]

    # Recompute continuation without modifying any retained count byte
    <<<<<<<< <<<[->>>>>>>>>+>+<<<<<<<<<<]>>>>>>>>>>[-<<<<<<<<<<+>>>>>>>>>>]<[[-]>>>[-]+<<<]
    <<<<<<<<[->>>>>>>>+>+<<<<<<<<<]>>>>>>>>>[-<<<<<<<<<+>>>>>>>>>]<[[-]>>>[-]+<<<]
    <<<<<<<[->>>>>>>+>+<<<<<<<<]>>>>>>>>[-<<<<<<<<+>>>>>>>>]<[[-]>>>[-]+<<<]
    <<<<<<[->>>>>>+>+<<<<<<<]>>>>>>>[-<<<<<<<+>>>>>>>]<[[-]>>>[-]+<<<]
    <<<<<[->>>>>+>+<<<<<<]>>>>>>[-<<<<<<+>>>>>>]<[[-]>>>[-]+<<<]
    <<<<[->>>>+>+<<<<<]>>>>>[-<<<<<+>>>>>]<[[-]>>>[-]+<<<]
    <<<[->>>+>+<<<<]>>>>[-<<<<+>>>>]<[[-]>>>[-]+<<<]
    <<[->>+>+<<<]>>>[-<<<+>>>]<[[-]>>>[-]+<<<]>>>
  ]

  # A required nonzero trailer detects EOF filled truncation
  <<<<,
  ---------- ---------- ---------- ---------- ---------- ---------- ---------- ----------
  ---------- ---------- ---------- ---------- ---------- ---------- ---------- ---------- -----
  [[-]<<<<<<<<<[-]+++++ +++++ +>>>>>>>> >]
  >>>>>>>> >>>>>>>> >>>>>
]
<<<<<<<< <<<<<<<< <<<<<<<< <<<<<<.

# END full width envelope admission with separate physical authority
